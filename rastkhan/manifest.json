{
  "manifest_version": 3,
  "name": "راست‌خوان",
  "version": "1.0.1",
  "description": "جهت خواندن هر بند را برای متن‌های فارسی، انگلیسی و دوزبانه تنظیم می‌کند.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "راست‌خوان",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_idle",
    "js": ["content.js"],
    "css": ["content.css"]
  }]
}
